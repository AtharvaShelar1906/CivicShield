# Root Environment Variables Template
# Copy this file to .env and adjust values if needed

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_DB=grievance_system_db
POSTGRES_PORT=5432

# Backend Service Configuration
BACKEND_PORT=5000
DATABASE_URL=postgresql://postgres:postgres_secure_password@postgres:5432/grievance_system_db?schema=public
ML_SERVICE_URL=http://intelligence-service:8000
JWT_SECRET=change_this_to_a_secure_random_jwt_secret_in_production
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173

# Intelligence / ML Service Configuration
ML_PORT=8000

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000/api
